generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum EventSuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ThemePreference {
  LIGHT
  DARK
}

model Office {
  id               String   @id @default(uuid())
  name             String   @unique
  city             String   @unique
  address          String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tables           Table[]
  preferredByUsers User[]   @relation("PreferredOffice")
}

model Table {
  id           Int               @id @default(autoincrement())
  officeId     String
  number       Int
  code         String
  office       Office            @relation(fields: [officeId], references: [id], onDelete: Restrict)
  reservations Reservation[]
  assignments  TableAssignment[]
  equipments   TableEquipment[]

  @@unique([officeId, number])
  @@unique([officeId, code])
  @@index([officeId])
}

model Equipment {
  id        String           @id @default(uuid())
  code      String           @unique
  name      String           @unique
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  tables    TableEquipment[]
}

model TableEquipment {
  tableId           Int
  equipmentId       String
  assignedAt        DateTime  @default(now())
  assignedByAdminId String?
  table             Table     @relation(fields: [tableId], references: [id], onDelete: Cascade)
  equipment         Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  assignedByAdmin   User?     @relation("TableEquipmentAssignedBy", fields: [assignedByAdminId], references: [id], onDelete: SetNull)

  @@id([tableId, equipmentId])
  @@index([equipmentId])
}

model Reservation {
  id                          String       @id @default(uuid())
  reservationDate             DateTime     @db.Date
  tableId                     Int
  userId                      String
  createdByAdminId            String?
  isCancelled                 Boolean      @default(false)
  cancelledAt                 DateTime?
  cancelledByUserId           String?
  cancellationReason          String?
  replacementForReservationId String?      @unique
  table                       Table        @relation(fields: [tableId], references: [id], onDelete: Restrict)
  user                        User         @relation("UserReservations", fields: [userId], references: [id], onDelete: Restrict)
  createdByAdmin              User?        @relation("ReservationCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  cancelledByUser             User?        @relation("ReservationCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  replacementForReservation   Reservation? @relation("ReservationReplacement", fields: [replacementForReservationId], references: [id], onDelete: SetNull)
  replacementReservation      Reservation? @relation("ReservationReplacement")
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt

  @@index([reservationDate])
  @@index([createdByAdminId])
}

model TableAssignment {
  id               String    @id @default(uuid())
  userId           String
  tableId          Int
  startsOn         DateTime  @db.Date
  endsOn           DateTime? @db.Date
  createdByAdminId String
  revokedAt        DateTime?
  revokedByAdminId String?
  revocationReason String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation("AssignedUser", fields: [userId], references: [id], onDelete: Restrict)
  table            Table     @relation(fields: [tableId], references: [id], onDelete: Restrict)
  createdByAdmin   User      @relation("AssignmentCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  revokedByAdmin   User?     @relation("AssignmentRevokedBy", fields: [revokedByAdminId], references: [id], onDelete: SetNull)

  @@index([userId, startsOn, endsOn])
  @@index([tableId, startsOn, endsOn])
}

model UserRestriction {
  id               String    @id @default(uuid())
  userId           String
  startsOn         DateTime  @db.Date
  endsOn           DateTime  @db.Date
  reason           String?
  createdByAdminId String
  revokedAt        DateTime?
  revokedByAdminId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation("RestrictedUser", fields: [userId], references: [id], onDelete: Restrict)
  createdByAdmin   User      @relation("RestrictionCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  revokedByAdmin   User?     @relation("RestrictionRevokedBy", fields: [revokedByAdminId], references: [id], onDelete: SetNull)

  @@index([userId, startsOn, endsOn])
}

model Notification {
  id                String    @id @default(uuid())
  userId            String
  type              String
  title             String
  message           String
  isRead            Boolean   @default(false)
  relatedEntityType String?
  relatedEntityId   String?
  createdAt         DateTime  @default(now())
  readAt            DateTime?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model AdminAuditLog {
  id          String   @id @default(uuid())
  adminUserId String
  action      String
  targetType  String
  targetId    String
  oldValue    Json?
  newValue    Json?
  reason      String?
  createdAt   DateTime @default(now())
  adminUser   User     @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId, createdAt])
  @@index([targetType, targetId])
}

model Event {
  id                 String           @id @default(uuid())
  title              String
  description        String
  startsAt           DateTime
  endsAt             DateTime
  location           String
  isCancelled        Boolean          @default(false)
  cancelledAt        DateTime?
  cancelledByAdminId String?
  cancellationReason String?
  createdByAdminId   String
  sourceSuggestionId String?          @unique
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  createdByAdmin     User             @relation("EventCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  cancelledByAdmin   User?            @relation("EventCancelledByAdmin", fields: [cancelledByAdminId], references: [id], onDelete: SetNull)
  sourceSuggestion   EventSuggestion? @relation(fields: [sourceSuggestionId], references: [id], onDelete: SetNull)
  reviews            EventReview[]

  @@index([startsAt, endsAt])
  @@index([isCancelled, startsAt])
  @@index([createdByAdminId])
}

model EventSuggestion {
  id                String                @id @default(uuid())
  suggestionText    String
  normalizedText    String
  status            EventSuggestionStatus @default(PENDING)
  userId            String
  reviewedByAdminId String?
  reviewedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  user              User                  @relation("EventSuggestionsByUser", fields: [userId], references: [id], onDelete: Restrict)
  reviewedByAdmin   User?                 @relation("EventSuggestionsReviewedByAdmin", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  event             Event?

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model EventReview {
  id               String    @id @default(uuid())
  eventId          String
  userId           String
  rating           Int
  comment          String?
  isDeleted        Boolean   @default(false)
  deletedAt        DateTime?
  deletedByAdminId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  event            Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user             User      @relation("EventReviewsByUser", fields: [userId], references: [id], onDelete: Restrict)
  deletedByAdmin   User?     @relation("EventReviewsDeletedByAdmin", fields: [deletedByAdminId], references: [id], onDelete: SetNull)

  @@unique([eventId, userId])
  @@index([eventId, isDeleted, createdAt])
  @@index([userId, createdAt])
}

model User {
  id                         String            @id @default(uuid())
  fullName                   String
  email                      String            @unique
  phone                      String
  passwordHash               String
  role                       UserRole          @default(USER)
  isActive                   Boolean           @default(true)
  preferredOfficeId          String?
  themePreference            ThemePreference   @default(LIGHT)
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  preferredOffice            Office?           @relation("PreferredOffice", fields: [preferredOfficeId], references: [id], onDelete: SetNull)
  reservations               Reservation[]     @relation("UserReservations")
  reservationsCreatedByAdmin Reservation[]     @relation("ReservationCreatedByAdmin")
  reservationsCancelled      Reservation[]     @relation("ReservationCancelledBy")
  assignments                TableAssignment[] @relation("AssignedUser")
  assignmentsCreated         TableAssignment[] @relation("AssignmentCreatedBy")
  assignmentsRevoked         TableAssignment[] @relation("AssignmentRevokedBy")
  restrictions               UserRestriction[] @relation("RestrictedUser")
  restrictionsCreated        UserRestriction[] @relation("RestrictionCreatedBy")
  restrictionsRevoked        UserRestriction[] @relation("RestrictionRevokedBy")
  equipmentAssignments       TableEquipment[]  @relation("TableEquipmentAssignedBy")
  notifications              Notification[]
  adminAuditLogs             AdminAuditLog[]
  eventsCreated              Event[]           @relation("EventCreatedByAdmin")
  eventsCancelled            Event[]           @relation("EventCancelledByAdmin")
  eventSuggestions           EventSuggestion[] @relation("EventSuggestionsByUser")
  eventSuggestionsReviewed   EventSuggestion[] @relation("EventSuggestionsReviewedByAdmin")
  eventReviews               EventReview[]     @relation("EventReviewsByUser")
  eventReviewsDeleted        EventReview[]     @relation("EventReviewsDeletedByAdmin")

  @@index([preferredOfficeId])
}
